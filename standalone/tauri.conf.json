{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buddy AD",
  "version": "1.0.0",
  "identifier": "com.buddyad.main",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Buddy AD",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}